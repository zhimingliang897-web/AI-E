  {
    "id": "20_20",
    "text": "事实性捏造：最常见。比如编造一本不存在的书、一篇不存在的论文，甚至煞有介事地列出虚构作者和链接。",
    "visual": {
      "type": "clipart",
      "prompt": null,
      "source": "assets/manual/20事实性捏造.png",
      "scene_class": null,
      "fallback": null
