    "transition": "fade_black"
  },
  {
    "id": "23_23",
    "text": "因为模型是‘接龙’的，如果它在第10个字选了一个概率只有1%的错字，那么第11个字就会基于这个错字继续圆谎。",
    "visual": {
      "type": "manim",
      "prompt": "Animated chain: word1 → word2 → ... → word10 (glowing red) → word11 (branching wrong), all in clean 3D cartoon style",
      "source": null,
      "scene_class": "LieCompounding",
      "fallback": null
    },
    "avatar": {
      "mode": "hidden",
      "scale": 0.3
    },
    "audio": {
      "mode": "auto",
      "override": null
    },
    "transition": "crossfade"
  },
  {
    "id": "24_24",
    "text": "这就像撒了一个谎，后面要用一百个谎来圆。",
    "visual": {
      "type": "clipart",
      "prompt": null,
      "source": "assets/manual/24撒谎比喻.png",
      "scene_class": null,
      "fallback": null
    },
    "avatar": {
      "mode": "hidden",
      "scale": 0.3
