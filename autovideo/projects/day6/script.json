    },
    "audio": {
      "mode": "auto",
      "override": null
    },
    "transition": "crossfade"
  },
  {
    "id": "30_30",
    "text": "AI 就像一个极度渴望回答你所有问题、读过无数书但偶尔会记串行的高材生。",
    "visual": {
      "type": "ai_image",
      "prompt": "Friendly cartoon student wearing glasses and holding thick books, slightly confused, standing next to a glowing brain icon with tangled wires, high quality 3D realistic cartoon style, bright lighting",
