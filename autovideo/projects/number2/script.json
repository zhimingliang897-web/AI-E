    "transition": "crossfade"
  },
  {
    "id": "05_cv_ultimate",
    "text": "它的终极目标很简单：让计算机像人类一样，读懂每一张图像、每一段视频。",
    "visual": {
      "type": "solid_bg",
      "prompt": "像人类一样读懂影像",
      "source": null,
      "scene_class": null,
      "fallback": null
