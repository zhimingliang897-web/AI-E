      "mode": "auto",
      "override": null
    },
    "transition": "crossfade"
  },
  {
    "id": "07_matrix_view",
    "text": "在计算机眼中，图片并非色彩斑斓的风景，而是一堆冰冷的数字矩阵。",
    "visual": {
      "type": "manim",
      "prompt": "Show a colorful landscape photo dissolving into a grid of green binary numbers and matrices",
      "source": null,
      "scene_class": "ImageToMatrix",
