    "audio": {
      "mode": "auto",
      "override": null
    },
    "transition": "cut"
  },
  {
    "id": "06_what_is_vision",
    "text": "那么，什么是视觉模型？简单来说，它是像素世界的“翻译官”。",
    "visual": {
      "type": "clipart",
      "prompt": null,
      "source": "assets/manual/06_what_is_vision.png",
      "scene_class": null,
      "fallback": null
    },
