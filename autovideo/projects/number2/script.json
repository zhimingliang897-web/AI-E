    "audio": {
      "mode": "auto",
      "override": null
    },
    "transition": "cut"
  },
  {
    "id": "04_cv_goal",
    "text": "那么 CV 要解决的，就是让 AI 真正“看见”这个世界。",
    "visual": {
      "type": "ai_image",
      "prompt": "A futuristic digital eye scanning a chaotic real-world street, transforming it into structured data streams, cyberpunk style, cinematic lighting, 4k",
      "source": null,
