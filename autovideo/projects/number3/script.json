    "transition": "cut"
  },
  {
    "id": "04_def_bridge",
    "text": "它是你输入给模型的一段文字，是你和 AI 交流的唯一桥梁。",
    "visual": {
      "type": "clipart",
      "prompt": null,
      "source": "assets/manual/04_def_bridge.png",
