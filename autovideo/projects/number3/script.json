    "transition": "crossfade"
  },
  {
    "id": "05_def_simple",
    "text": "简单来说：Prompt 就是你对 AI 发出的“命令”。",
    "visual": {
      "type": "solid_bg",
      "prompt": "Prompt = 命令",
