  {
    "id": "03_def_name",
    "text": "这个指令，就叫 Prompt，中文通常翻译为“提示词”。",
    "visual": {
      "type": "solid_bg",
      "prompt": "Prompt = 提示词",
      "source": null,
      "scene_class": null,
      "fallback": null
    },
