      "override": null
    },
    "transition": "crossfade"
  },
  {
    "id": "21_21",
    "text": "逻辑性矛盾：上一段说 A 是对的，下一段又推导出 A 是错的，上下文不能自圆其说。",
    "visual": {
      "type": "manim",
      "prompt": "Two speech bubbles: top says 'A is true', bottom says 'A is false', connected by a red X, clean 3D cartoon style",
      "source": null,
      "scene_class": "LogicalContradiction",
      "fallback": null
    },
    "avatar": {
      "mode": "hidden",
      "scale": 0.3
    },
    "audio": {
      "mode": "auto",
      "override": null
    },
    "transition": "crossfade"
  },
  {
    "id": "22_title_sideeffect",
    "text": "",
    "visual": {
      "type": "title_card",
      "prompt": "一个有趣的副作用：圆谎机制 The Lie-Compounding Effect",
      "source": null,
      "scene_class": null,
      "fallback": null
    },
    "avatar": {
      "mode": "hidden",
      "scale": 0.3
    },
    "audio": {
      "mode": "auto",
      "override": null
