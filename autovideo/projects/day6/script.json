    "audio": {
      "mode": "auto",
      "override": null
    },
    "transition": "crossfade"
  },
  {
    "id": "25_25",
    "text": "这就是为什么模型有时候会一本正经地胡说八道。",
    "visual": {
      "type": "solid_bg",
      "prompt": "一本正经胡说",
      "source": null,
      "scene_class": null,
      "fallback": null
